# Copy to .env and fill in. .env is git-ignored.

# ── Text and images ─────────────────────────────────────────────────────────
# Google Gemini (https://aistudio.google.com/apikey): text and images.
# Instead you can set OPENAI_API_KEY (any OpenAI-compatible server; name its models
# in config.yaml) or DASHSCOPE_API_KEY (Alibaba Cloud Model Studio,
# https://bailian.console.aliyun.com: DeepSeek + Qwen-Image).
GEMINI_API_KEY=

# ── Video ───────────────────────────────────────────────────────────────────
# Your Murea-Fast service (see ../inference/README.md), e.g. http://127.0.0.1:30260.
# Add MUREA_API_KEY only if an authenticating proxy sits in front of it.
MUREA_URL=
