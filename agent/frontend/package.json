    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
